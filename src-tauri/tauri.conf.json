{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "FLIP",
  "version": "0.3.0",
  "identifier": "com.miguelflor.flip",
  "build": {
    "frontendDist": "../vue-app/dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "cd vue-app && npm run dev",
    "beforeBuildCommand": "cd vue-app && npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "FLIP",
        "width": 1200,
        "height": 800,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self'",
        "font-src": "'self' data:",
        "img-src": "'self' data:",
        "connect-src": "'self' ipc: http://ipc.localhost",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'"
      },
      "devCsp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "font-src": "'self' data:",
        "img-src": "'self' data:",
        "connect-src": "'self' ipc: http://ipc.localhost ws://localhost:1420",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
